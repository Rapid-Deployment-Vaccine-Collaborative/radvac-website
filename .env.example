# ===== Required in all environments =====
SKIP_WP_HEALTHCHECK=1
# WordPress GraphQL endpoint
# Local dev:  http://localhost:8080/graphql  (docker stack in ./wordpress)
# Production: https://radvac-297e5f.ingress-alpha.ewp.live/graphql (EasyWP-provided host)
WP_GRAPHQL_URL=http://localhost:8080/graphql

# Public WordPress URL (used to rewrite /wp-content/uploads URLs in rendered HTML).
# Must match the host of WP_GRAPHQL_URL minus the /graphql path.
NEXT_PUBLIC_WP_URL=http://localhost:8080

# Public site URL — used by the WP revalidation webhook target and OG tags.
# Local dev:  http://localhost:3000
# Production: https://radvac.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret between WP mu-plugin and /api/revalidate.
# Generate with: openssl rand -hex 32
PREVIEW_SECRET=
REVALIDATE_SECRET=

# Resend API key for the /contact form. Get one at https://resend.com.
# The `radvac.org` sending domain must also be verified in Resend
# (SPF + DKIM DNS records).
RESEND_API_KEY=

# Mailchimp newsletter signup (footer). Find the audience ID under
# Audience → Settings → Audience name and defaults. The server prefix is the
# suffix after the dash on your API key (e.g. "us21").
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# Cloudflare Turnstile — gates the footer Discord link behind a human check.
# Create a widget at https://dash.cloudflare.com → Turnstile (free; the site
# does NOT need to be on Cloudflare). Add your domain(s) + `localhost`.
# The site key is public; the secret key is server-only. The invite URL is
# server-only (no NEXT_PUBLIC_ prefix) so it never ships in the browser bundle.
# For local testing, Cloudflare's always-pass test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
DISCORD_INVITE_URL=

# ===== Optional =====

# Pulls Yoast SEO fields (meta title/desc, canonical, OG, Twitter) into
# `generateMetadata`. Requires both `Yoast SEO` and `Add WPGraphQL SEO`
# active on the WP instance — already installed on production. Set to
# "false" (or unset) if pointing at a local WP without those plugins.
WP_GRAPHQL_SEO_ENABLED=true

# Token for fetching draft/unpublished content via WPGraphQL.
# Only needed if you use draft preview.
# Format: base64("username:application-password") using WP core Application Passwords
# (Users → Profile → Application Passwords). Sent as `Authorization: Basic <token>`.
# Generate locally with:  echo -n 'user:abcd efgh ijkl mnop qrst uvwx' | base64
# WP_AUTH_TOKEN=
