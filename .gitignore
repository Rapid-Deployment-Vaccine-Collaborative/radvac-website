# WordPress exports (the 2026-01-27 dump is ~181 MB). Scoped to the export
# filenames at the repo root on purpose: a bare `*.xml` also swallowed
# wordpress/import/*.xml and would silently ignore public/sitemap.xml.
/radvac.WordPress.*.xml

# Built plugin bundles (source lives in wordpress/plugins/*/)
/wordpress/plugins/*.zip

# WordPress imported media (large; restored from XML/dump, not source)
/wordpress/uploads/

# Large local media not meant for git
*.mp4
*.mov

# Reference material (not part of build; Tailwind v4 auto-scans untracked files)
/example_site/

# Stray 4.7MB source video at the repo root: never served (Next only serves
# public/), and the code points at the WordPress-hosted copy under
# /wp-content/uploads/. Kept locally, out of git.
/science-faster.webm
